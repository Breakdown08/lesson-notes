# Directory with OBS recordings (the newest one is used when no file is given)
LESSON_NOTES_RECORDINGS_DIR=~/Videos/lessons
# Directory for <yyyy-mm-dd>/transcript.md and summary.md (must exist)
LESSON_NOTES_OUTPUT_DIR=~/lesson-notes/out
# Directory for the summary copy <yyyy-mm-dd>.md (must exist)
LESSON_NOTES_SUMMARY_COPY_DIR=~/notes/lessons
# Summary provider: xai or anthropic. Only the key of the selected provider is required.
LESSON_NOTES_LLM_PROVIDER=xai
XAI_API_KEY=
# xAI model name
XAI_MODEL=grok-4.7
ANTHROPIC_API_KEY=
# Anthropic model name
ANTHROPIC_MODEL=claude-haiku-5-5
# Audio track (1-based, audio streams only) with the student's microphone
LESSON_NOTES_STUDENT_TRACK=1
# Audio track with the teacher's voice (system sound)
LESSON_NOTES_TEACHER_TRACK=2
# faster-whisper model name
LESSON_NOTES_WHISPER_MODEL=large-v3-turbo
# faster-whisper compute type
LESSON_NOTES_WHISPER_COMPUTE_TYPE=int8
# Language of the summary
LESSON_NOTES_SUMMARY_LANGUAGE=Russian
